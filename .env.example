# Public app URL (used for OG, canonical, redirect URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Quiz-from-notes generation. Set at least one of these.
# Tried in this order: Anthropic → Groq → Gemini. Each falls through on error.
# Anthropic Claude — best quality, paid (~pennies per quiz). Get key: https://console.anthropic.com
ANTHROPIC_API_KEY=
# Groq — free, very fast, 30 req/min on Llama 3.3 70B. Get key: https://console.groq.com
GROQ_API_KEY=
# Google Gemini — free, 10 req/min on 2.5 Flash. Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Supabase (Phase 2+)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Phase 11)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Sentry (Phase 0)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Analytics (Phase 0)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
