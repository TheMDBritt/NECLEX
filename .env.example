# Public app URL (used for OG, canonical, redirect URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Quiz-from-notes generation. Set at least one of these.
# Anthropic Claude — best quality, paid (~pennies per quiz). Get key: https://console.anthropic.com
ANTHROPIC_API_KEY=
# Google Gemini — generous free tier (1500 req/day). Get key: https://aistudio.google.com/apikey
# Used as a fallback if Anthropic is unset or returns an error.
GEMINI_API_KEY=

# Supabase (Phase 2+)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Phase 11)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Sentry (Phase 0)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Analytics (Phase 0)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
